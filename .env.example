AI_ANALYSIS_READ_TIMEOUT=30s
AI_RECOMMENDATION_CONNECT_TIMEOUT=2s
AI_RECOMMENDATION_READ_TIMEOUT=10s
# Deprecated compatibility fallback; prefer the two service-specific URLs.
