FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=ai requirements.txt /tmp/requirements.txt
COPY deploy/requirements.recommend-api.constraints.txt /tmp/constraints.txt
RUN pip install --no-cache-dir --requirement /tmp/requirements.txt --constraint /tmp/constraints.txt \
    && rm -f /tmp/requirements.txt /tmp/constraints.txt

COPY --from=ai main.py ml_engine.py package_rules.py daily_usage.py graph_reasons.py llm_reasons.py survey_map.py ./
COPY --from=ai 적합도_전상품.csv 상품_용량.csv 상품별_효능_v4.csv ./
COPY --from=ai graph ./graph

RUN groupadd --system packly \
    && useradd --system --gid packly --no-create-home packly \
    && chown -R packly:packly /app

USER packly
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
