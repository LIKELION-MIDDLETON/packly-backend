FROM python:3.11-slim-bookworm

RUN apt-get update \
    && apt-get install --no-install-recommends --yes libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.13.0+cpu torchvision==0.28.0+cpu \
    && pip install --no-cache-dir \
        "fastapi==0.141.1" "uvicorn[standard]==0.52.4" \
        "pydantic==2.13.4" "Pillow==12.3.0" "numpy==2.4.6" \
        "openai==3.3.1" "python-dotenv==1.2.3" "python-multipart==0.0.32"

COPY config.py cnn_infer.py cnn_model.py llm_analyzer.py pipeline.py survey.py server.py ./
COPY checkpoints/class_names.json /app/checkpoints/class_names.json

RUN groupadd --system packly \
    && useradd --system --gid packly --no-create-home packly \
    && install -d -o packly -g packly /app/checkpoints \
    && chown packly:packly /app/checkpoints/class_names.json

USER packly
EXPOSE 8001
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
